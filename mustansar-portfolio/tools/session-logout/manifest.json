{
  "manifest_version": 3,
  "name": "Session Logout",
  "version": "1.0.0",
  "description": "Manually log out (clear cookies + storage) for a list of sites you choose. Logout-only, fully local, no network access.",
  "permissions": ["browsingData", "storage"],
  "action": {
    "default_title": "Session Logout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
